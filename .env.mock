# Mock-store preview. Loaded on top of `.env` by `npm run preview:mock`
# (Vite mode "mock"). Contains no secrets: mock.shop is Shopify's public demo
# Storefront API and needs no token.
#
# Purpose: exercise the real cart flow (price, stock badges, add to cart,
# cart drawer, "Finalizar compra") while the Bio Three store is unavailable or
# the `biothree` product doesn't exist yet. Prices show in CAD and the checkout
# lands on a mock page — that's expected.
SESSION_SECRET=mock-preview-session-secret
PUBLIC_STORE_DOMAIN=mock.shop
PUBLIC_STOREFRONT_API_TOKEN=
PUBLIC_STOREFRONT_ID=
PUBLIC_CHECKOUT_DOMAIN=mock.shop

# Map the two marketing presentations (Tabletas, Sobres) onto a mock product.
# "hoodie-old" ships one variant with only 3 units, which lights up the
# low-stock badge. Swap for `soft-cotton-hoodie-in-clay` to see "Agotado".
PREVIEW_PRODUCT_HANDLE=hoodie-old
PREVIEW_OPTION_NAME=Size
PREVIEW_OPTION_VALUES=Small,Medium
